# Ассистент. Ключ требуется только для ответов LLM.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# ASSISTANT_PROVIDER=deepseek
# ASSISTANT_DEADLINE=100
# ASSISTANT_MAX_OUTPUT_TOKENS=0

# При выборе ASSISTANT_PROVIDER=runpod заполнить ключ и ID endpoint.
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=
# RUNPOD_MODEL=glm-5.3
# RUNPOD_THINKING=default
# RUNPOD_REASONING_EFFORT=low

# HTTP. Списки источников CORS и доверенных прокси разделяются запятыми.
# CORS_ORIGINS=
# TRUSTED_PROXIES=  # CIDR ranges/IPs of *actual* reverse proxies only
# SESSION_SECRET=

# Гибридный поиск. EMBEDDING_URL нужен для переопределения адреса Compose.
# EMBEDDING_URL=http://embeddings:8080/v1/embeddings
# EMBEDDING_TIMEOUT=15
# SEMANTIC_MIN_SCORE=0.55
# SEMANTIC_POOL=40
